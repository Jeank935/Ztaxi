{
  "version": 8,
  "name": "Zamora noche · Ztaxi",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org/\">OpenFreeMap</a> © <a href=\"https://openmaptiles.org/\">OpenMapTiles</a> © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#414650"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "park"
      ],
      "paint": {
        "fill-color": "#3b4a46",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#303741"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#303741",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          1,
          17,
          5
        ]
      }
    },
    {
      "id": "street-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "!=",
        [
          "get",
          "class"
        ],
        "path"
      ],
      "paint": {
        "line-color": "#292f38",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          1,
          16,
          5,
          19,
          11
        ]
      }
    },
    {
      "id": "streets",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "!=",
        [
          "get",
          "class"
        ],
        "path"
      ],
      "paint": {
        "line-color": "#525b66",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.5,
          16,
          2.5,
          19,
          7
        ]
      }
    },
    {
      "id": "main-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary"
          ]
        ]
      ],
      "paint": {
        "line-color": "#7a858e",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          1,
          16,
          3,
          19,
          8
        ]
      }
    },
    {
      "id": "place-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 11,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "city",
            "town",
            "village",
            "neighbourhood",
            "suburb"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:es"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 13,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#d2d9dc",
        "text-halo-color": "#414650",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "street-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 16,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:es"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#bac4cc",
        "text-halo-color": "#414650",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "local-landmarks",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 15,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "hospital",
            "pharmacy",
            "school",
            "college",
            "park",
            "bus",
            "shop",
            "grocery",
            "restaurant"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:es"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 10,
        "text-padding": 12
      },
      "paint": {
        "text-color": "#a9cfbc",
        "text-halo-color": "#414650",
        "text-halo-width": 1.5
      }
    }
  ]
}
